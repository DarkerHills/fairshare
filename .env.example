# Firebase web app settings, from Project settings > Your apps.
# Copy this file to .env.local and fill it in. Leave it empty to keep houses in this browser only.
# These values identify the project; they are meant to ship inside the web app and are not passwords.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
